# Optional: Archidekt credentials for private deck access (self-host only)
# ARCHIDEKT_USERNAME=
# ARCHIDEKT_PASSWORD=

# Optional: where the auto-refreshed Comprehensive Rules copy is cached (self-host only)
# MYSTIC_FORGE_CR=cr_cache.txt

# Optional: skip MTGStocks print-id lookups during ingest. Watchlist cards
# then render without their MTGStocks badge; nothing else changes.
# MYSTIC_FORGE_NO_MTGSTOCKS=1

# Optional escape hatch: disable the price sidecar (price_sidecar.sqlite) and
# fall back to scanning MTGJSON's AllPrices for watchlist history. Set to any
# value. The file is left in place but stops being updated — and it holds
# history past MTGJSON's ~90-day replay window, so a long stint disabled
# leaves a gap nothing can backfill.
# MYSTIC_FORGE_NO_SIDECAR=1
